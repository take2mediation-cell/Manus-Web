<?xml version="1.0" encoding="utf-8"?>
<!--
  packageNames is intentionally left out. Restricting to a fixed package here
  would hard-code a guess at Chai's package name into the build. Instead the
  service narrows itself at runtime through setServiceInfo() using whatever the
  user picked in the app picker, so it listens to that one app and nothing else.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackSpoken"
    android:accessibilityFlags="flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="200"
    android:settingsActivity="com.take2.chainarrator.ui.MainActivity" />
