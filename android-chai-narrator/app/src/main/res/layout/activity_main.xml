<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <!-- Step 1: overlay permission -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/overlayTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_overlay_title"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/step_overlay_body"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/overlayButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/step_overlay_button" />
        </LinearLayout>

        <!-- Step 2: accessibility service -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/accessibilityTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_accessibility_title"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/step_accessibility_body"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/accessibilityButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/step_accessibility_button" />
        </LinearLayout>

        <!-- Step 3: target app -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/targetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_target_title"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/step_target_body"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/targetValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/accent"
                android:textSize="15sp" />

            <Button
                android:id="@+id/targetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/step_target_button" />
        </LinearLayout>

        <!-- Step 4: voice -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/voiceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_voice_title"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/step_voice_body"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/voiceValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/accent"
                android:textSize="15sp" />

            <Button
                android:id="@+id/voiceButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/step_voice_button" />
        </LinearLayout>

        <!-- Delivery controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_delivery"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_rate"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/rateSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:id="@+id/pitchLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_pitch"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/pitchSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <Button
                android:id="@+id/testButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/action_test_voice" />

            <CheckBox
                android:id="@+id/autoReadCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_auto_read" />

            <CheckBox
                android:id="@+id/sentencePauseCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_sentence_pauses" />

            <CheckBox
                android:id="@+id/summariseCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_summarise" />

            <TextView
                android:id="@+id/thresholdLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/thresholdSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <CheckBox
                android:id="@+id/verbatimCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_verbatim_instructions" />
        </LinearLayout>

        <Button
            android:id="@+id/bubbleToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/action_start_bubble" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/accessibility_service_description"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
